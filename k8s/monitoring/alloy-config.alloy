// 1. DISCOVERY: Find all pods in the EKS cluster
discovery.kubernetes "all_pods" {
  role = "pod"
}

// 2. METRICS: Collect Prometheus numbers from the pods
prometheus.scrape "kubernetes_pods" {
  targets    = discovery.kubernetes.all_pods.targets
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
}

// 3. LOGS: Collect text logs from the pods
loki.source.kubernetes "all_logs" {
  targets    = discovery.kubernetes.all_pods.targets
  forward_to = [loki.write.grafana_cloud.receiver]
}

// 4. SHIPPING: Send metrics to Grafana Cloud Metrics warehouse
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = "https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push" // UPDATE THIS
    basic_auth {
      username = "YOUR_METRICS_USER_ID"
      password = "YOUR_GRAFANA_CLOUD_API_TOKEN"
    }
  }
}

// 5. SHIPPING: Send logs to Grafana Cloud Loki warehouse
loki.write "grafana_cloud" {
  endpoint {
    url = "https://logs-prod-006.grafana.net/loki/api/v1/push" // UPDATE THIS
    basic_auth {
      username = "YOUR_LOGS_USER_ID"
      password = "YOUR_GRAFANA_CLOUD_API_TOKEN"
    }
  }
}
